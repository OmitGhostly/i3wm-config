# dunst: notification daemon (replaces swaync). Colors: dunstrc.d/50-mono.conf (dunst >= 1.9)
[global]
    monitor = 0
    follow = mouse
    width = 400
    height = 200
    origin = top-right
    offset = 14x40
    notification_limit = 6
    progress_bar = true
    progress_bar_height = 10
    progress_bar_frame_width = 1
    indicate_hidden = yes
    separator_height = 2
    padding = 12
    horizontal_padding = 14
    frame_width = 1
    corner_radius = 6
    gap_size = 6
    sort = yes
    font = FantasqueSansM Nerd Font Mono 10
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    show_age_threshold = 60
    icon_position = left
    min_icon_size = 32
    max_icon_size = 48
    enable_recursive_icon_lookup = true
    dmenu = /usr/bin/rofi -dmenu -p dunst
    browser = /usr/bin/xdg-open
    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all
    history_length = 50
    stack_duplicates = true
[urgency_low]
    timeout = 4
[urgency_normal]
    timeout = 8
[urgency_critical]
    timeout = 0
