bindsym $mod+Return exec --no-startup-id $scripts/LaunchTerminal.sh
## file manager
bindsym $mod+e exec --no-startup-id $scripts/LaunchFileManager.sh
## open default browser
bindsym $mod+b exec --no-startup-id $scripts/LaunchBrowser.sh
## SSH session manager
bindsym $mod+c exec --no-startup-id $scripts/rofi-ssh-menu.sh
## help / cheat sheet
bindsym $mod+h exec --no-startup-id $scripts/KeyHints.sh
## search keybinds
bindsym $mod+Shift+k exec --no-startup-id $scripts/KeyBinds.sh
## web search
bindsym $mod+s exec --no-startup-id $scripts/RofiSearch.sh
## window switcher (overview replacement)
bindsym $mod+a exec --no-startup-id pkill rofi || rofi -show window -config $rofi_cfg
## window switcher
bindsym $mod+Ctrl+s exec --no-startup-id pkill rofi || rofi -show window -config $rofi_cfg
## emoji menu
bindsym $mod+$alt+e exec --no-startup-id $scripts/RofiEmoji.sh
## calculator
bindsym $mod+$alt+c exec --no-startup-id $scripts/RofiCalc.sh
## clipboard manager
bindsym $mod+$alt+v exec --no-startup-id $scripts/ClipManager.sh
## online music
bindsym $mod+Shift+m exec --no-startup-id $scripts/RofiBeats.sh
## quick settings menu
bindsym $mod+Shift+e exec --no-startup-id $scripts/QuickSettings.sh
## rofi theme selector
bindsym $mod+Ctrl+r exec --no-startup-id $scripts/RofiThemeSelector.sh
## rofi theme selector (modified)
bindsym $mod+Ctrl+Shift+r exec --no-startup-id "pkill rofi; $scripts/RofiThemeSelector-modified.sh"
