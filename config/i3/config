# =============================================================================
#  i3 config - port of KooL Hyprland-Dots (LinuxBeginnings) | GPL-3.0-or-later
#  Requires i3 >= 4.22 (built-in gaps). Lines starting with "## " are the
#  descriptions shown by SUPER+H / SUPER+SHIFT+K (KeyHints.sh). Keys can be changed in
#  the settings window (SUPER+ALT+M, Keybindings tab), which edits the bindsym lines below.
# =============================================================================

set $mod Mod4
set $alt Mod1
set $scripts ~/.config/i3/scripts
set $rofi_cfg ~/.config/i3/rofi/config.rasi

font pango:FantasqueSansM Nerd Font Mono 10
floating_modifier $mod
focus_follows_mouse yes
default_orientation horizontal
workspace_layout default
# new windows never open as tabs; with spiral tiling on (AutoTiling.py) they split the focused window like Hyprland

# ---- look: monochrome (starterpack-style gaps/borders, black & white) -----------
# every window, tiled or floating, gets the same border: the focused one is drawn in the accent colour (the "ring")
default_border pixel 3
default_floating_border pixel 3
title_align center
# (no "hide_edge_borders": even a window that is alone on the screen keeps its ring, so every app shows it)
hide_edge_borders none
gaps inner 5
gaps outer 0
# lone window: no gaps either
smart_gaps on

# workspace names: numbers keep the keybinds, roman numerals are what the bar shows
set $ws1  "1:I"
set $ws2  "2:II"
set $ws3  "3:III"
set $ws4  "4:IV"
set $ws5  "5:V"
set $ws6  "6:VI"
set $ws7  "7:VII"
set $ws8  "8:VIII"
set $ws9  "9:IX"
set $ws10 "10:X"

set $black #000000
set $dark  #1c1c1c
set $line  #303030
set $grey  #8c8c8c
set $white #ffffff
# the accent colour (white = monochrome). The Settings window's Colors tab changes this line.
set $accent #ffffff
#                       border  background text    indicator child_border
client.focused          $accent $accent    $black  $accent   $accent
client.focused_inactive $line   $dark      $grey   $line     $line
client.unfocused        $line   $black     $grey   $line     $line
client.urgent           $grey   $grey      $black  $grey     $grey
client.placeholder      $black  $black     $grey   $black    $black
client.background       $black

