# ---- window rules (ported from lua/window_rules.lua) -------------------------
# Apps that draw their own title bar (Firefox, Chrome, VS Code, Discord, Spotify, GNOME apps...) ask for no border,
# so i3 would skip the focus ring on them. Give every window the border; the rules below can still change it.
# (Some ask again after they have opened; AutoTiling.py puts the border back then. To hide a window's border on
# purpose, use "border pixel 0" like the mpv rule below - "border none" would be undone.)
for_window [all] border pixel 3
for_window [window_role="(pop-up|dialog|task_dialog|About)"] floating enable
for_window [window_type="dialog"] floating enable
for_window [window_type="utility"] floating enable
for_window [window_type="splash"] floating enable
for_window [class="(?i)^(zoom|onedriver|onedriver-launcher)$"] floating enable
for_window [class="^(mpv|com.github.rafostar.Clapper)$"] floating enable
for_window [class="(?i)^(qalculate-gtk|org.gnome.Calculator)$"] floating enable, resize set 600 500, move position center
for_window [title="^(Authentication [Rr]equired)$"] floating enable, move position center
for_window [class="(?i)^(xfce-polkit|mate-polkit|polkit-mate-authentication-agent-1|polkit-gnome-authentication-agent-1|lxpolkit)$"] floating enable, move position center
for_window [title="^(Add Folder to Workspace|Save As|Open Files)$"] floating enable, resize set 70 ppt 60 ppt, move position center
for_window [class="^yad$"] floating enable, move position center
for_window [class="(?i)^(pavucontrol|org.pulseaudio.pavucontrol|com.saivert.pwvucontrol)$"] floating enable, resize set 900 600, move position center
for_window [class="(?i)^nm-connection-editor$"] floating enable, move position center
for_window [class="(?i)^nm-applet$"] floating enable, move position center
for_window [class="(?i)^(nwg-look|nwg-displays|arandr|blueman-manager)$"] floating enable, move position center
for_window [instance="^i3dots-settings$" window_type="normal"] floating enable, move position center
for_window [class="(?i)^(nvidia-settings|org.kde.kwalletmanager|bitwarden|com.github.wwmm.easyeffects|io.github.amit9838.mousam|nz.co.mega.megasync|wihotspot|wihotspot-gui|ferdium)$"] floating enable, move position center
for_window [class="(?i)^(whatsapp-for-linux|zapzap|com.rtosta.zapzap)$"] move position center
for_window [title="^(KooL Quick Cheat Sheet|Keybindings|ROG Control)$"] floating enable, move position center
for_window [class="(?i)^steam$" title="^(?!Steam$).+"] floating enable
for_window [title="^[Pp]icture-in-[Pp]icture$"] floating enable, sticky enable, resize set 480 270
for_window [class="^com\.i3dots\.dropterm$"] floating enable, resize set 1200 600, move position center, move scratchpad, scratchpad show
for_window [class="^kitty-dropterm$"] floating enable, resize set 1200 600, move position center, move scratchpad, scratchpad show
for_window [class="^(gamescope|steam_app_.*)$"] fullscreen enable
for_window [class="^(mpv|vlc)$"] border pixel 0

# ---- autostart (ported from lua/startup.lua) --------------------------------------
exec --no-startup-id dbus-update-activation-environment --systemd DISPLAY XAUTHORITY
exec --no-startup-id ~/.config/i3/scripts/Input.sh
exec --no-startup-id ~/.config/i3/scripts/Polkit.sh
exec --no-startup-id ~/.config/i3/scripts/Picom.sh
exec --no-startup-id dunst
exec --no-startup-id ~/.config/i3/scripts/Wallpaper.sh --restore
# NetworkManager's password helper (nm-applet), with its tray icon hidden: the Wi-Fi item in the bar opens
# Settings > Wi-Fi instead. The icon can be switched back on there. (exec_always: it only starts once.)
exec_always --no-startup-id ~/.config/i3/scripts/NetApplet.sh
# the cursor you picked in Settings > Mouse, also for GTK / Flatpak apps (xsettingsd; exec_always: starts once)
exec_always --no-startup-id ~/.config/i3/scripts/XSettings.sh
exec --no-startup-id xss-lock --transfer-sleep-lock -- ~/.config/i3/scripts/LockScreen.sh
exec --no-startup-id ~/.config/i3/scripts/ClipDaemon.sh
# saved mouse / monitor settings (written by the settings window), then re-draw the bar for the new layout
# (the wallpaper is drawn again once the screens are set up, so two monitors never get a misaligned picture)
exec --no-startup-id sh -c '~/.config/i3/scripts/SettingsGUI.py --apply; ~/.config/i3/scripts/Wallpaper.sh --restore; sleep 1; ~/.config/polybar/launch.sh'
exec --no-startup-id ~/.config/i3/scripts/Nightlight.sh init
# game mode never survives a logout (its gaps/compositor changes are gone too)
exec --no-startup-id rm -f ~/.cache/i3/gamemode
exec --no-startup-id ~/.config/i3/scripts/first-run.sh
# after a system update you were not logged in for: fetch the newest desktop config from GitHub (i3dots-update)
exec --no-startup-id ~/.config/i3/scripts/Update.sh --login
# re-launched on every reload so the bar picks up new colors / monitors
exec_always --no-startup-id ~/.config/polybar/launch.sh
# Hyprland-style spiral tiling (new windows split the focused one along its longer side). Only one copy runs;
# it follows i3 through restarts. Mode: SUPER+ALT+T or Settings > Appearance > Window tiling.
exec_always --no-startup-id ~/.config/i3/scripts/AutoTiling.py
# touchpad: swipe with three fingers to go to the next / previous workspace (Touchégg; Settings > Mouse & touchpad)
exec_always --no-startup-id ~/.config/i3/scripts/Gestures.sh
# a mouse or touchpad plugged in later (or a Bluetooth mouse reconnecting) gets your Settings > Mouse choices too
exec_always --no-startup-id ~/.config/i3/scripts/InputWatch.py

# ---- used by the settings window while it records a new key (leaves with XF86Launch9) ----
mode "keycapture" {
    bindsym XF86Launch9 mode "default"
}
