# ---- window / layout ----------------------------------------------------------
## fullscreen
bindsym $mod+Shift+f fullscreen toggle
## fullscreen (maximize)
bindsym $mod+f fullscreen toggle
## toggle floating
bindsym $mod+space floating toggle
## floating: standard size, centered
bindsym $mod+Ctrl+space floating enable, resize set 1100 650, move position center
## toggle layout (split/tabbed/stacking)
bindsym $mod+$alt+l layout toggle all
## layout: side by side (the normal split layout)
bindsym $mod+$alt+1 layout splith
## layout: stacking
bindsym $mod+$alt+2 layout stacking
## layout: tabbed (monocle-like)
bindsym $mod+$alt+3 layout tabbed
## toggle group (tabbed/split)
bindsym $mod+g layout toggle tabbed split
## toggle split direction
bindsym $mod+Shift+i layout toggle split
## toggle spiral tiling like Hyprland (on) / classic side by side (off)
bindsym $mod+$alt+t exec --no-startup-id $scripts/AutoTiling.py --toggle
## focus parent container (group)
bindsym $mod+Ctrl+h focus parent
## focus child container
bindsym $mod+Ctrl+j focus child
## split next window horizontally
bindsym $mod+backslash split h
## split next window vertically
bindsym $mod+minus split v
## toggle sticky
bindsym $mod+Shift+t sticky toggle
## focus: switch tiling/floating
